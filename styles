/* =========================================
   1. DESIGN TOKENS (VARIABLES GLOBALES)
   ========================================= */
:root {
  /* Colores Base */
  --bg-app: #f6f8fb;
  --bg-surface: #ffffff;
  --bg-sidebar: #0f172a;
  --bg-sidebar-hover: #1e293b;
  --bg-subtle: #f1f5f9;

  /* Textos */
  --text-primary: #0f172a;
  --text-secondary: #475569;
  --text-muted: #94a3b8;
  --text-inverse: #f8fafc;

  /* Acentos Fintech */
  --accent-primary: #4f46e5;       /* Índigo tecnológico */
  --accent-primary-hover: #4338ca;
  --accent-soft: #eef2ff;

  /* Estados Financieros */
  --color-positive: #059669;       /* Esmeralda */
  --color-positive-bg: #ecfdf5;
  --color-negative: #dc2626;       /* Carmesí */
  --color-negative-bg: #fef2f2;
  --color-warning: #d97706;        /* Ámbar */
  --color-warning-bg: #fffbeb;

  /* Bordes y Sombras */
  --border-color: #e2e8f0;
  --shadow-sm: 0 1px 2px rgba(15, 23, 42, 0.04);
  --shadow-md: 0 4px 12px rgba(15, 23, 42, 0.06);
  --radius-sm: 8px;
  --radius-md: 12px;
  --radius-lg: 16px;

  /* Tipografía */
  --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
  --font-mono: 'JetBrains Mono', monospace;
}

/* =========================================
   2. RESET Y BASE
   ========================================= */
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: var(--font-sans);
  background-color: var(--bg-app);
  color: var(--text-primary);
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

.mono {
  font-family: var(--font-mono);
  font-variant-numeric: tabular-nums;
}

.positive-text { color: var(--color-positive); }
.warning-text  { color: var(--color-warning); }
.text-right    { text-align: right; }

/* =========================================
   3. LAYOUT PRINCIPAL (SIDEBAR + MAIN)
   ========================================= */
.app-layout {
  display: flex;
  min-height: 100vh;
}

/* Sidebar */
.sidebar {
  width: 260px;
  background-color: var(--bg-sidebar);
  color: var(--text-inverse);
  display: flex;
  flex-direction: column;
  padding: 24px 16px;
  position: fixed;
  top: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
}

.sidebar-header {
  padding: 0 8px 20px;
}

.brand-logo {
  display: flex;
  align-items: center;
  gap: 12px;
}

.logo-mark {
  width: 36px;
  height: 36px;
  background: linear-gradient(135deg, #6366f1, #3b82f6);
  border-radius: 10px;
  display: grid;
  place-items: center;
  font-weight: 700;
  font-size: 14px;
  letter-spacing: 0.5px;
}

.brand-info {
  display: flex;
  flex-direction: column;
}

.brand-name {
  font-weight: 700;
  font-size: 16px;
  letter-spacing: -0.02em;
}

.brand-badge {
  font-size: 10px;
  font-weight: 600;
  color: #93c5fd;
  letter-spacing: 0.08em;
}

.company-selector {
  background-color: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: var(--radius-md);
  padding: 10px 12px;
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 24px;
}

.company-avatar {
  width: 32px;
  height: 32px;
  border-radius: 8px;
  background-color: #334155;
  display: grid;
  place-items: center;
  font-size: 12px;
  font-weight: 600;
}

.company-details {
  display: flex;
  flex-direction: column;
}

.company-name {
  font-size: 13px;
  font-weight: 600;
}

.company-plan {
  font-size: 11px;
  color: var(--text-muted);
}

.sidebar-nav {
  display: flex;
  flex-direction: column;
  gap: 4px;
  flex: 1;
}

.nav-section-title {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.08em;
  color: #64748b;
  padding: 14px 12px 6px;
}

.nav-item {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 10px 12px;
  border-radius: var(--radius-sm);
  color: #cbd5e1;
  text-decoration: none;
  font-size: 14px;
  font-weight: 500;
  transition: all 0.18s ease;
}

.nav-item svg {
  width: 18px;
  height: 18px;
  opacity: 0.8;
}

.nav-item:hover {
  background-color: var(--bg-sidebar-hover);
  color: #ffffff;
}

.nav-item.active {
  background-color: var(--accent-primary);
  color: #ffffff;
  box-shadow: 0 4px 12px rgba(79, 70, 229, 0.35);
}

.nav-item.active svg {
  opacity: 1;
}

.pill-new {
  margin-left: auto;
  font-size: 10px;
  font-weight: 600;
  background-color: rgba(99, 102, 241, 0.25);
  color: #a5b4fc;
  padding: 2px 7px;
  border-radius: 99px;
}

.sidebar-footer {
  padding-top: 16px;
  border-top: 1px solid rgba(255, 255, 255, 0.08);
}

.demo-status {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 12px;
  color: #94a3b8;
  padding: 4px 8px;
}

.status-dot {
  width: 8px;
  height: 8px;
  background-color: #10b981;
  border-radius: 50%;
  box-shadow: 0 0 8px #10b981;
}

/* Contenido Principal */
.main-content {
  margin-left: 260px;
  flex: 1;
  padding: 28px 36px;
  max-width: 1440px;
}

/* =========================================
   4. TOPBAR Y CONTROLES
   ========================================= */
.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 16px;
  margin-bottom: 24px;
}

.page-title h1 {
  font-size: 24px;
  font-weight: 700;
  letter-spacing: -0.02em;
}

.page-title p {
  font-size: 13px;
  color: var(--text-secondary);
}

.topbar-actions {
  display: flex;
  align-items: center;
  gap: 12px;
}

.period-filter {
  background-color: var(--bg-surface);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-sm);
  padding: 3px;
  display: flex;
  gap: 2px;
}

.filter-btn {
  border: none;
  background: transparent;
  padding: 6px 12px;
  font-size: 13px;
  font-weight: 500;
  color: var(--text-secondary);
  border-radius: 6px;
  cursor: pointer;
  transition: all 0.15s ease;
}

.filter-btn:hover {
  color: var(--text-primary);
}

.filter-btn.active {
  background-color: var(--bg-subtle);
  color: var(--text-primary);
  font-weight: 600;
}

.btn-primary {
  background-color: var(--accent-primary);
  color: #ffffff;
  border: none;
  padding: 9px 16px;
  border-radius: var(--radius-sm);
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  transition: background-color 0.15s ease, transform 0.1s ease;
}

.btn-primary:hover {
  background-color: var(--accent-primary-hover);
}

.btn-secondary {
  display: inline-block;
  background-color: var(--accent-soft);
  color: var(--accent-primary);
  text-decoration: none;
  font-size: 12px;
  font-weight: 600;
  padding: 8px 12px;
  border-radius: var(--radius-sm);
  transition: all 0.15s ease;
}

.btn-secondary:hover {
  background-color: #e0e7ff;
}

.btn-ghost {
  color: var(--accent-primary);
  text-decoration: none;
  font-size: 13px;
  font-weight: 600;
}

/* =========================================
   5. ALERTA INTELIGENTE Y KPIS
   ========================================= */
.alert-banner {
  background-color: var(--bg-surface);
  border: 1px solid #c7d2fe;
  border-left: 4px solid var(--accent-primary);
  border-radius: var(--radius-md);
  padding: 12px 18px;
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 24px;
  box-shadow: var(--shadow-sm);
}

.alert-text {
  font-size: 13px;
  color: var(--text-secondary);
  flex: 1;
}

.alert-link {
  font-size: 13px;
  font-weight: 600;
  color: var(--accent-primary);
  text-decoration: none;
  white-space: nowrap;
}

.kpi-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
  margin-bottom: 24px;
}

.kpi-card {
  background-color: var(--bg-surface);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-lg);
  padding: 20px;
  box-shadow: var(--shadow-sm);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.kpi-card:hover {
  transform: translateY(-2px);
  box-shadow: var(--shadow-md);
}

.kpi-card.featured {
  background: linear-gradient(145deg, #ffffff 0%, #f8faff 100%);
  border-color: #cbd5e1;
}

.kpi-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10px;
}

.kpi-label {
  font-size: 13px;
  font-weight: 500;
  color: var(--text-secondary);
}

.kpi-trend {
  font-size: 12px;
  font-weight: 600;
  padding: 2px 8px;
  border-radius: 99px;
}

.kpi-trend.positive {
  background-color: var(--color-positive-bg);
  color: var(--color-positive);
}

.kpi-trend.negative {
  background-color: var(--color-negative-bg);
  color: var(--color-negative);
}

.kpi-value {
  font-size: 24px;
  font-weight: 600;
  letter-spacing: -0.03em;
  margin-bottom: 6px;
}

.kpi-subtext {
  font-size: 12px;
  color: var(--text-muted);
}

/* =========================================
   6. TARJETAS DE ANÁLISIS Y GRÁFICAS
   ========================================= */
.dashboard-grid {
  display: grid;
  grid-template-columns: 1.5fr 1fr;
  gap: 20px;
  margin-bottom: 24px;
}

.card {
  background-color: var(--bg-surface);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-lg);
  padding: 24px;
  box-shadow: var(--shadow-sm);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20px;
}

.card-header h2 {
  font-size: 16px;
  font-weight: 600;
}

.card-subtitle {
  font-size: 12px;
  color: var(--text-muted);
}

.chart-legend {
  display: flex;
  gap: 14px;
  font-size: 12px;
  color: var(--text-secondary);
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 6px;
}

.dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  display: inline-block;
}

.dot.income  { background-color: var(--accent-primary); }
.dot.expense { background-color: #cbd5e1; }

/* Gráfica de Barras CSS */
.bar-chart {
  height: 220px;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16px;
  padding-top: 24px;
  border-bottom: 1px solid var(--border-color);
}

.bar-group {
  flex: 1;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
}

.bars {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 6px;
}

.bar {
  width: 18px;
  border-radius: 6px 6px 0 0;
  transition: opacity 0.2s ease, transform 0.2s ease;
  position: relative;
  cursor: pointer;
}

.bar:hover {
  opacity: 0.85;
  transform: scaleY(1.03);
  transform-origin: bottom;
}

.bar.income  { background-color: var(--accent-primary); }
.bar.expense { background-color: #cbd5e1; }

.bar-label {
  font-size: 12px;
  color: var(--text-secondary);
  margin-top: 10px;
  margin-bottom: -26px;
}

.bar-group.active .bar-label {
  font-weight: 700;
  color: var(--accent-primary);
}

/* Compromisos y Barras de Progreso */
.obligation-block {
  margin-bottom: 16px;
}

.obligation-top {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8px;
  font-size: 14px;
}

.ob-title { font-weight: 500; }
.ob-amount { font-weight: 600; }

.progress-track {
  height: 8px;
  background-color: var(--bg-subtle);
  border-radius: 99px;
  overflow: hidden;
  margin-bottom: 6px;
}

.progress-fill {
  height: 100%;
  border-radius: 99px;
}

.progress-fill.income  { background-color: var(--color-positive); }
.progress-fill.warning { background-color: var(--color-warning); }

.obligation-meta {
  display: flex;
  justify-content: space-between;
  font-size: 11px;
  color: var(--text-muted);
}

.divider {
  height: 1px;
  background-color: var(--border-color);
  margin: 18px 0;
}

.flow-preview-box {
  background-color: var(--bg-subtle);
  border-radius: var(--radius-md);
  padding: 14px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  margin-top: 18px;
}

.flow-preview-info {
  display: flex;
  flex-direction: column;
  font-size: 12px;
}

.flow-preview-info span {
  color: var(--text-secondary);
  font-size: 11px;
}

/* =========================================
   7. TABLA DE TRANSACCIONES LIMPIA
   ========================================= */
.table-responsive {
  overflow-x: auto;
}

.fintech-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 13px;
}

.fintech-table th {
  text-align: left;
  font-size: 11px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--text-muted);
  padding: 12px 10px;
  border-bottom: 1px solid var(--border-color);
}

.fintech-table td {
  padding: 14px 10px;
  border-bottom: 1px solid var(--bg-subtle);
  vertical-align: middle;
}

.fintech-table tr:last-child td {
  border-bottom: none;
}

.fintech-table tr:hover td {
  background-color: #fafbfc;
}

.tx-entity {
  display: flex;
  align-items: center;
  gap: 12px;
}

.tx-icon {
  width: 32px;
  height: 32px;
  border-radius: 8px;
  display: grid;
  place-items: center;
  font-weight: 700;
  font-size: 14px;
}

.tx-icon.in  { background-color: var(--color-positive-bg); color: var(--color-positive); }
.tx-icon.out { background-color: var(--bg-subtle); color: var(--text-secondary); }

.tx-entity strong {
  display: block;
  font-size: 13px;
  color: var(--text-primary);
}

.tx-sub {
  font-size: 11px;
  color: var(--text-muted);
}

.badge {
  font-size: 11px;
  font-weight: 600;
  padding: 4px 10px;
  border-radius: 99px;
}

.badge-income  { background-color: var(--color-positive-bg); color: var(--color-positive); }
.badge-neutral { background-color: var(--bg-subtle); color: var(--text-secondary); }

/* =========================================
   8. RESPONSIVIDAD (TABLET Y MÓVIL)
   ========================================= */
@media (max-width: 1150px) {
  .kpi-grid {
    grid-template-columns: repeat(2, 1fr);
  }
  .dashboard-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 768px) {
  .sidebar {
    display: none; /* En móvil se convertirá en menú colapsable con JS */
  }
  .main-content {
    margin-left: 0;
    padding: 20px;
  }
  .kpi-grid {
    grid-template-columns: 1fr;
  }
}

/* =========================================
   9. VISTAS, MONEY FLOW, SIMULADOR Y MODAL
   ========================================= */
.app-view {
  display: none;
}

.app-view.active {
  display: block;
}

.negative-text {
  color: var(--color-negative);
}

.inline-link {
  color: var(--accent-primary);
  text-decoration: none;
  font-weight: 600;
}

.badge-warning {
  background-color: var(--color-warning-bg);
  color: var(--color-warning);
}

.btn-reset-demo {
  margin-top: 10px;
  width: 100%;
  background: rgba(255, 255, 255, 0.06);
  color: #cbd5e1;
  border: 1px solid rgba(255, 255, 255, 0.12);
  padding: 7px 10px;
  border-radius: var(--radius-sm);
  font-size: 12px;
  cursor: pointer;
}

.btn-reset-demo:hover {
  background: rgba(255, 255, 255, 0.12);
  color: #ffffff;
}

/* Money Flow */
.flow-columns {
  display: grid;
  grid-template-columns: 1fr 0.9fr 1fr;
  gap: 20px;
  align-items: center;
  margin-top: 12px;
}

.flow-col h3 {
  font-size: 13px;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--text-secondary);
  margin-bottom: 12px;
}

.flow-node {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14px 16px;
  border-radius: var(--radius-md);
  border: 1px solid var(--border-color);
  background: var(--bg-surface);
  margin-bottom: 10px;
  cursor: pointer;
  font-family: var(--font-sans);
  font-size: 13px;
  transition: transform 0.15s ease, border-color 0.15s ease;
}

.flow-node:hover {
  transform: translateY(-2px);
  border-color: var(--accent-primary);
}

.flow-node.income-node {
  border-left: 4px solid var(--color-positive);
}

.flow-node.expense-node {
  border-left: 4px solid var(--color-warning);
}

.flow-node.reserve-node {
  border-left: 4px solid var(--accent-primary);
  background: var(--accent-soft);
}

.center-hub {
  text-align: center;
}

.hub-card {
  background: var(--bg-sidebar);
  color: var(--text-inverse);
  padding: 20px;
  border-radius: var(--radius-lg);
  cursor: pointer;
}

.hub-tag {
  display: block;
  font-size: 10px;
  letter-spacing: 0.08em;
  color: #93c5fd;
  margin-bottom: 6px;
}

.hub-card strong {
  display: block;
  font-size: 20px;
  margin-bottom: 4px;
}

.hub-card small {
  color: #94a3b8;
  font-size: 11px;
}

.flow-pipe {
  font-size: 12px;
  color: var(--text-muted);
  margin: 10px 0;
}

.flow-inspector {
  margin-top: 22px;
  padding: 16px 20px;
  border-radius: var(--radius-md);
  background: var(--bg-subtle);
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
}

.inspector-kicker {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.06em;
  color: var(--accent-primary);
}

.inspector-amount {
  font-size: 22px;
  font-weight: 700;
}

/* Simulador */
.sim-verdict {
  padding: 12px 16px;
  border-radius: var(--radius-md);
  font-size: 13px;
  font-weight: 500;
  margin-bottom: 20px;
}

.sim-verdict.alert-ok {
  background: var(--color-positive-bg);
  color: var(--color-positive);
}

.sim-verdict.alert-warn {
  background: var(--color-warning-bg);
  color: var(--color-warning);
}

.sim-verdict.alert-danger {
  background: var(--color-negative-bg);
  color: var(--color-negative);
}

.sim-grid {
  display: grid;
  grid-template-columns: 1fr 1.1fr;
  gap: 20px;
}

.sim-control {
  margin-bottom: 18px;
}

.sim-label-row {
  display: flex;
  justify-content: space-between;
  font-size: 13px;
  margin-bottom: 8px;
}

.sim-control input[type="range"] {
  width: 100%;
  accent-color: var(--accent-primary);
  cursor: pointer;
}

.sim-number-input,
.form-input,
.form-select {
  width: 100%;
  padding: 9px 12px;
  border: 1px solid var(--border-color);
  border-radius: var(--radius-sm);
  font-family: var(--font-sans);
  font-size: 13px;
  background: var(--bg-surface);
  color: var(--text-primary);
  margin-top: 6px;
}

.sim-kpis {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
  margin-bottom: 20px;
}

.sim-box {
  background: var(--bg-subtle);
  padding: 14px;
  border-radius: var(--radius-md);
}

.sim-box span {
  display: block;
  font-size: 11px;
  color: var(--text-secondary);
  margin-bottom: 4px;
}

.sim-box strong {
  font-size: 15px;
}

.sim-box.highlight {
  background: var(--accent-soft);
  border: 1px solid #c7d2fe;
}

.sim-bar-row {
  margin-bottom: 14px;
}

.sim-bar-meta {
  display: flex;
  justify-content: space-between;
  font-size: 12px;
  margin-bottom: 6px;
}

.progress-fill.primary {
  background-color: var(--accent-primary);
}

.progress-fill.danger {
  background-color: var(--color-negative);
}

.sim-breakdown {
  border-top: 1px solid var(--border-color);
  padding-top: 14px;
  margin-top: 14px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  font-size: 13px;
}

.sim-breakdown > div {
  display: flex;
  justify-content: space-between;
}

/* Filtros y Modal */
.tx-filters {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
}

.tx-filters .form-select,
.tx-filters .form-input {
  width: auto;
  margin-top: 0;
}

.modal-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.55);
  display: none;
  place-items: center;
  z-index: 200;
  padding: 16px;
}

.modal-backdrop.open {
  display: grid;
}

.modal-card {
  background: var(--bg-surface);
  border-radius: var(--radius-lg);
  padding: 24px;
  width: 100%;
  max-width: 480px;
  box-shadow: var(--shadow-md);
}

.modal-close {
  background: transparent;
  border: none;
  font-size: 18px;
  cursor: pointer;
  color: var(--text-secondary);
}

.modal-form {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.modal-form label {
  font-size: 12px;
  font-weight: 600;
  color: var(--text-secondary);
  display: flex;
  flex-direction: column;
}

.form-row-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}

.modal-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 8px;
}

@media (max-width: 960px) {
  .flow-columns,
  .sim-grid {
    grid-template-columns: 1fr;
  }
}
