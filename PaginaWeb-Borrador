<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sin Nombre — ERP Financiero Inteligente</title>
  <!-- Tipografía Fintech: Inter para UI y JetBrains Mono para cifras -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="css/styles.css">
</head>
<body>

  <div class="app-layout">
    <!-- SIDEBAR DE NAVEGACIÓN -->
    <aside class="sidebar">
      <div class="sidebar-header">
        <div class="brand-logo">
          <span class="logo-mark">SN</span>
          <div class="brand-info">
            <span class="brand-name">Sin Nombre</span>
            <span class="brand-badge">DEMO PYME</span>
          </div>
        </div>
      </div>

      <div class="company-selector">
        <div class="company-avatar">TC</div>
        <div class="company-details">
          <span class="company-name">TecnoCloud S.A.</span>
          <span class="company-plan">Cuenta Empresarial</span>
        </div>
      </div>

      <nav class="sidebar-nav">
        <span class="nav-section-title">ANÁLISIS Y CONTROL</span>
        <a href="#dashboard" class="nav-item active">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/></svg>
          Dashboard
        </a>
        <a href="#money-flow" class="nav-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
          Money Flow
          <span class="pill-new">Visual</span>
        </a>
        <a href="#simulador" class="nav-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="4" y1="21" x2="4" y2="14"/><line x1="4" y1="10" x2="4" y2="3"/><line x1="12" y1="21" x2="12" y2="12"/><line x1="12" y1="8" x2="12" y2="3"/><line x1="20" y1="21" x2="20" y2="16"/><line x1="20" y1="12" x2="20" y2="3"/><line x1="1" y1="14" x2="7" y2="14"/><line x1="9" y1="8" x2="15" y2="8"/><line x1="17" y1="16" x2="23" y2="16"/></svg>
          Simulador
        </a>

        <span class="nav-section-title">OPERACIONES</span>
        <a href="#cuentas" class="nav-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
          Cuentas y Bancos
        </a>
        <a href="#transacciones" class="nav-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="17 1 21 5 17 9"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><polyline points="7 23 3 19 7 15"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg>
          Transacciones
        </a>
        <a href="#cobrar" class="nav-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          Cuentas por Cobrar
        </a>
        <a href="#pagar" class="nav-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
          Cuentas por Pagar
        </a>
      </nav>

      <div class="sidebar-footer">
        <div class="demo-status">
          <span class="status-dot"></span>
          Modo Feria Tecnológica Activo
        </div>
      </div>
    </aside>

    <!-- CONTENIDO PRINCIPAL -->
    <main class="main-content">
      <!-- BARRA SUPERIOR -->
      <header class="topbar">
        <div class="page-title">
          <h1>Resumen Financiero</h1>
          <p>Estado consolidado en tiempo real • Actualizado hoy, 09:14 AM</p>
        </div>

        <div class="topbar-actions">
          <div class="period-filter" role="group" aria-label="Filtro de periodo">
            <button class="filter-btn">Día</button>
            <button class="filter-btn">Semana</button>
            <button class="filter-btn active">Mes</button>
            <button class="filter-btn">Trimestre</button>
            <button class="filter-btn">Año</button>
          </div>
          <button class="btn-primary">+ Nuevo Movimiento</button>
        </div>
      </header>

      <!-- ALERTA FINANCIERA INTELIGENTE -->
      <section class="alert-banner">
        <div class="alert-icon">⚡</div>
        <div class="alert-text">
          <strong>Proyección de liquidez saludable:</strong> Tienes <strong>$184,500.00 MXN</strong> por cobrar en los próximos 15 días, cubriendo 2.4x tus compromisos inmediatos.
        </div>
        <a href="#simulador" class="alert-link">Simular escenario →</a>
      </section>

      <!-- TARJETAS KPI PRINCIPALES -->
      <section class="kpi-grid">
        <article class="kpi-card featured">
          <div class="kpi-header">
            <span class="kpi-label">Balance Total Disponible</span>
            <span class="kpi-trend positive">+12.4%</span>
          </div>
          <div class="kpi-value mono">$1,248,900.00</div>
          <div class="kpi-subtext">Distribuido en 3 cuentas bancarias</div>
        </article>

        <article class="kpi-card">
          <div class="kpi-header">
            <span class="kpi-label">Ingresos del Mes</span>
            <span class="kpi-trend positive">+8.2%</span>
          </div>
          <div class="kpi-value mono">$482,300.00</div>
          <div class="kpi-subtext">Meta mensual: $450,000.00</div>
        </article>

        <article class="kpi-card">
          <div class="kpi-header">
            <span class="kpi-label">Gastos Operativos</span>
            <span class="kpi-trend negative">+3.1%</span>
          </div>
          <div class="kpi-value mono">$291,450.00</div>
          <div class="kpi-subtext">Margen operativo neto: 39.5%</div>
        </article>

        <article class="kpi-card">
          <div class="kpi-header">
            <span class="kpi-label">Flujo de Efectivo Neto</span>
            <span class="kpi-trend positive">+$190,850</span>
          </div>
          <div class="kpi-value mono positive-text">+$190,850.00</div>
          <div class="kpi-subtext">Runway estimado: 14.2 meses</div>
        </article>
      </section>

      <!-- SECCIÓN MEDIA: GRÁFICA COMPARATIVA + COMPROMISOS -->
      <section class="dashboard-grid">
        <!-- GRÁFICA DE INGRESOS VS GASTOS -->
        <article class="card chart-card">
          <div class="card-header">
            <div>
              <h2>Ingresos vs. Gastos</h2>
              <p class="card-subtitle">Comportamiento semestral (Cifras en miles MXN)</p>
            </div>
            <div class="chart-legend">
              <span class="legend-item"><i class="dot income"></i>Ingresos</span>
              <span class="legend-item"><i class="dot expense"></i>Gastos</span>
            </div>
          </div>

          <!-- Gráfica de barras CSS limpia y responsiva -->
          <div class="bar-chart">
            <div class="bar-group">
              <div class="bars">
                <div class="bar income" style="height: 62%;" data-value="$380k"></div>
                <div class="bar expense" style="height: 45%;" data-value="$260k"></div>
              </div>
              <span class="bar-label">Jun</span>
            </div>
            <div class="bar-group">
              <div class="bars">
                <div class="bar income" style="height: 70%;" data-value="$410k"></div>
                <div class="bar expense" style="height: 48%;" data-value="$275k"></div>
              </div>
              <span class="bar-label">Jul</span>
            </div>
            <div class="bar-group">
              <div class="bars">
                <div class="bar income" style="height: 66%;" data-value="$395k"></div>
                <div class="bar expense" style="height: 52%;" data-value="$290k"></div>
              </div>
              <span class="bar-label">Ago</span>
            </div>
            <div class="bar-group">
              <div class="bars">
                <div class="bar income" style="height: 82%;" data-value="$445k"></div>
                <div class="bar expense" style="height: 50%;" data-value="$280k"></div>
              </div>
              <span class="bar-label">Sep</span>
            </div>
            <div class="bar-group">
              <div class="bars">
                <div class="bar income" style="height: 78%;" data-value="$430k"></div>
                <div class="bar expense" style="height: 47%;" data-value="$268k"></div>
              </div>
              <span class="bar-label">Oct</span>
            </div>
            <div class="bar-group active">
              <div class="bars">
                <div class="bar income" style="height: 92%;" data-value="$482k"></div>
                <div class="bar expense" style="height: 54%;" data-value="$291k"></div>
              </div>
              <span class="bar-label">Nov</span>
            </div>
          </div>
        </article>

        <!-- CUENTAS POR COBRAR Y PAGAR -->
        <article class="card obligations-card">
          <div class="card-header">
            <div>
              <h2>Compromisos Financieros</h2>
              <p class="card-subtitle">Cartera activa y vencimientos</p>
            </div>
          </div>

          <div class="obligation-block">
            <div class="obligation-top">
              <span class="ob-title">Cuentas por Cobrar</span>
              <span class="ob-amount mono positive-text">$184,500.00</span>
            </div>
            <div class="progress-track">
              <div class="progress-fill income" style="width: 74%;"></div>
            </div>
            <div class="obligation-meta">
              <span>74% al corriente</span>
              <span>$48,000 por vencer esta semana</span>
            </div>
          </div>

          <div class="divider"></div>

          <div class="obligation-block">
            <div class="obligation-top">
              <span class="ob-title">Cuentas por Pagar</span>
              <span class="ob-amount mono warning-text">$76,200.00</span>
            </div>
            <div class="progress-track">
              <div class="progress-fill warning" style="width: 38%;"></div>
            </div>
            <div class="obligation-meta">
              <span>3 proveedores pendientes</span>
              <span>Próximo pago: 30 Nov</span>
            </div>
          </div>

          <div class="flow-preview-box">
            <div class="flow-preview-info">
              <strong>Distribución del Gasto</strong>
              <span>Nómina (48%) • Software (22%) • Operación (30%)</span>
            </div>
            <a href="#money-flow" class="btn-secondary">Ver Money Flow</a>
          </div>
        </article>
      </section>

      <!-- ÚLTIMAS TRANSACCIONES -->
      <section class="card transactions-card">
        <div class="card-header">
          <div>
            <h2>Movimientos Recientes</h2>
            <p class="card-subtitle">Últimas operaciones conciliadas automáticamente</p>
          </div>
          <a href="#transacciones" class="btn-ghost">Ver historial completo</a>
        </div>

        <div class="table-responsive">
          <table class="fintech-table">
            <thead>
              <tr>
                <th>Concepto / Entidad</th>
                <th>Categoría</th>
                <th>Cuenta</th>
                <th>Fecha</th>
                <th class="text-right">Monto</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>
                  <div class="tx-entity">
                    <span class="tx-icon in">↓</span>
                    <div>
                      <strong>Pago Factura #F-1042 — Grupo Alfa</strong>
                      <span class="tx-sub">Transferencia SPEI</span>
                    </div>
                  </div>
                </td>
                <td><span class="badge badge-income">Ventas B2B</span></td>
                <td>BBVA Empresarial</td>
                <td>25 Nov 2026</td>
                <td class="text-right mono positive-text">+$95,400.00</td>
              </tr>
              <tr>
                <td>
                  <div class="tx-entity">
                    <span class="tx-icon out">↑</span>
                    <div>
                      <strong>Amazon Web Services (AWS)</strong>
                      <span class="tx-sub">Cargo recurrente</span>
                    </div>
                  </div>
                </td>
                <td><span class="badge badge-neutral">Infraestructura</span></td>
                <td>Tarjeta Corporativa</td>
                <td>24 Nov 2026</td>
                <td class="text-right mono">-$18,250.00</td>
              </tr>
              <tr>
                <td>
                  <div class="tx-entity">
                    <span class="tx-icon out">↑</span>
                    <div>
                      <strong>Dispersión Nómina Quincenal</strong>
                      <span class="tx-sub">12 colaboradores</span>
                    </div>
                  </div>
                </td>
                <td><span class="badge badge-neutral">Nómina</span></td>
                <td>Santander PyME</td>
                <td>15 Nov 2026</td>
                <td class="text-right mono">-$142,000.00</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>
    </main>
  </div>

</body>
</html>


styles.css:

/* =========================================
   1. DESIGN TOKENS (VARIABLES GLOBALES)
   ========================================= */
:root {
  /* Colores Base */
  --bg-app: #f6f8fb;
  --bg-surface: #ffffff;
  --bg-sidebar: #0f172a;
  --bg-sidebar-hover: #1e293b;
  --bg-subtle: #f1f5f9;

  /* Textos */
  --text-primary: #0f172a;
  --text-secondary: #475569;
  --text-muted: #94a3b8;
  --text-inverse: #f8fafc;

  /* Acentos Fintech */
  --accent-primary: #4f46e5;       /* Índigo tecnológico */
  --accent-primary-hover: #4338ca;
  --accent-soft: #eef2ff;

  /* Estados Financieros */
  --color-positive: #059669;       /* Esmeralda */
  --color-positive-bg: #ecfdf5;
  --color-negative: #dc2626;       /* Carmesí */
  --color-negative-bg: #fef2f2;
  --color-warning: #d97706;        /* Ámbar */
  --color-warning-bg: #fffbeb;

  /* Bordes y Sombras */
  --border-color: #e2e8f0;
  --shadow-sm: 0 1px 2px rgba(15, 23, 42, 0.04);
  --shadow-md: 0 4px 12px rgba(15, 23, 42, 0.06);
  --radius-sm: 8px;
  --radius-md: 12px;
  --radius-lg: 16px;

  /* Tipografía */
  --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
  --font-mono: 'JetBrains Mono', monospace;
}

/* =========================================
   2. RESET Y BASE
   ========================================= */
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: var(--font-sans);
  background-color: var(--bg-app);
  color: var(--text-primary);
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

.mono {
  font-family: var(--font-mono);
  font-variant-numeric: tabular-nums;
}

.positive-text { color: var(--color-positive); }
.warning-text  { color: var(--color-warning); }
.text-right    { text-align: right; }

/* =========================================
   3. LAYOUT PRINCIPAL (SIDEBAR + MAIN)
   ========================================= */
.app-layout {
  display: flex;
  min-height: 100vh;
}

/* Sidebar */
.sidebar {
  width: 260px;
  background-color: var(--bg-sidebar);
  color: var(--text-inverse);
  display: flex;
  flex-direction: column;
  padding: 24px 16px;
  position: fixed;
  top: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
}

.sidebar-header {
  padding: 0 8px 20px;
}

.brand-logo {
  display: flex;
  align-items: center;
  gap: 12px;
}

.logo-mark {
  width: 36px;
  height: 36px;
  background: linear-gradient(135deg, #6366f1, #3b82f6);
  border-radius: 10px;
  display: grid;
  place-items: center;
  font-weight: 700;
  font-size: 14px;
  letter-spacing: 0.5px;
}

.brand-info {
  display: flex;
  flex-direction: column;
}

.brand-name {
  font-weight: 700;
  font-size: 16px;
  letter-spacing: -0.02em;
}

.brand-badge {
  font-size: 10px;
  font-weight: 600;
  color: #93c5fd;
  letter-spacing: 0.08em;
}

.company-selector {
  background-color: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: var(--radius-md);
  padding: 10px 12px;
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 24px;
}

.company-avatar {
  width: 32px;
  height: 32px;
  border-radius: 8px;
  background-color: #334155;
  display: grid;
  place-items: center;
  font-size: 12px;
  font-weight: 600;
}

.company-details {
  display: flex;
  flex-direction: column;
}

.company-name {
  font-size: 13px;
  font-weight: 600;
}

.company-plan {
  font-size: 11px;
  color: var(--text-muted);
}

.sidebar-nav {
  display: flex;
  flex-direction: column;
  gap: 4px;
  flex: 1;
}

.nav-section-title {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.08em;
  color: #64748b;
  padding: 14px 12px 6px;
}

.nav-item {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 10px 12px;
  border-radius: var(--radius-sm);
  color: #cbd5e1;
  text-decoration: none;
  font-size: 14px;
  font-weight: 500;
  transition: all 0.18s ease;
}

.nav-item svg {
  width: 18px;
  height: 18px;
  opacity: 0.8;
}

.nav-item:hover {
  background-color: var(--bg-sidebar-hover);
  color: #ffffff;
}

.nav-item.active {
  background-color: var(--accent-primary);
  color: #ffffff;
  box-shadow: 0 4px 12px rgba(79, 70, 229, 0.35);
}

.nav-item.active svg {
  opacity: 1;
}

.pill-new {
  margin-left: auto;
  font-size: 10px;
  font-weight: 600;
  background-color: rgba(99, 102, 241, 0.25);
  color: #a5b4fc;
  padding: 2px 7px;
  border-radius: 99px;
}

.sidebar-footer {
  padding-top: 16px;
  border-top: 1px solid rgba(255, 255, 255, 0.08);
}

.demo-status {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 12px;
  color: #94a3b8;
  padding: 4px 8px;
}

.status-dot {
  width: 8px;
  height: 8px;
  background-color: #10b981;
  border-radius: 50%;
  box-shadow: 0 0 8px #10b981;
}

/* Contenido Principal */
.main-content {
  margin-left: 260px;
  flex: 1;
  padding: 28px 36px;
  max-width: 1440px;
}

/* =========================================
   4. TOPBAR Y CONTROLES
   ========================================= */
.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 16px;
  margin-bottom: 24px;
}

.page-title h1 {
  font-size: 24px;
  font-weight: 700;
  letter-spacing: -0.02em;
}

.page-title p {
  font-size: 13px;
  color: var(--text-secondary);
}

.topbar-actions {
  display: flex;
  align-items: center;
  gap: 12px;
}

.period-filter {
  background-color: var(--bg-surface);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-sm);
  padding: 3px;
  display: flex;
  gap: 2px;
}

.filter-btn {
  border: none;
  background: transparent;
  padding: 6px 12px;
  font-size: 13px;
  font-weight: 500;
  color: var(--text-secondary);
  border-radius: 6px;
  cursor: pointer;
  transition: all 0.15s ease;
}

.filter-btn:hover {
  color: var(--text-primary);
}

.filter-btn.active {
  background-color: var(--bg-subtle);
  color: var(--text-primary);
  font-weight: 600;
}

.btn-primary {
  background-color: var(--accent-primary);
  color: #ffffff;
  border: none;
  padding: 9px 16px;
  border-radius: var(--radius-sm);
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  transition: background-color 0.15s ease, transform 0.1s ease;
}

.btn-primary:hover {
  background-color: var(--accent-primary-hover);
}

.btn-secondary {
  display: inline-block;
  background-color: var(--accent-soft);
  color: var(--accent-primary);
  text-decoration: none;
  font-size: 12px;
  font-weight: 600;
  padding: 8px 12px;
  border-radius: var(--radius-sm);
  transition: all 0.15s ease;
}

.btn-secondary:hover {
  background-color: #e0e7ff;
}

.btn-ghost {
  color: var(--accent-primary);
  text-decoration: none;
  font-size: 13px;
  font-weight: 600;
}

/* =========================================
   5. ALERTA INTELIGENTE Y KPIS
   ========================================= */
.alert-banner {
  background-color: var(--bg-surface);
  border: 1px solid #c7d2fe;
  border-left: 4px solid var(--accent-primary);
  border-radius: var(--radius-md);
  padding: 12px 18px;
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 24px;
  box-shadow: var(--shadow-sm);
}

.alert-text {
  font-size: 13px;
  color: var(--text-secondary);
  flex: 1;
}

.alert-link {
  font-size: 13px;
  font-weight: 600;
  color: var(--accent-primary);
  text-decoration: none;
  white-space: nowrap;
}

.kpi-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
  margin-bottom: 24px;
}

.kpi-card {
  background-color: var(--bg-surface);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-lg);
  padding: 20px;
  box-shadow: var(--shadow-sm);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.kpi-card:hover {
  transform: translateY(-2px);
  box-shadow: var(--shadow-md);
}

.kpi-card.featured {
  background: linear-gradient(145deg, #ffffff 0%, #f8faff 100%);
  border-color: #cbd5e1;
}

.kpi-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10px;
}

.kpi-label {
  font-size: 13px;
  font-weight: 500;
  color: var(--text-secondary);
}

.kpi-trend {
  font-size: 12px;
  font-weight: 600;
  padding: 2px 8px;
  border-radius: 99px;
}

.kpi-trend.positive {
  background-color: var(--color-positive-bg);
  color: var(--color-positive);
}

.kpi-trend.negative {
  background-color: var(--color-negative-bg);
  color: var(--color-negative);
}

.kpi-value {
  font-size: 24px;
  font-weight: 600;
  letter-spacing: -0.03em;
  margin-bottom: 6px;
}

.kpi-subtext {
  font-size: 12px;
  color: var(--text-muted);
}

/* =========================================
   6. TARJETAS DE ANÁLISIS Y GRÁFICAS
   ========================================= */
.dashboard-grid {
  display: grid;
  grid-template-columns: 1.5fr 1fr;
  gap: 20px;
  margin-bottom: 24px;
}

.card {
  background-color: var(--bg-surface);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-lg);
  padding: 24px;
  box-shadow: var(--shadow-sm);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20px;
}

.card-header h2 {
  font-size: 16px;
  font-weight: 600;
}

.card-subtitle {
  font-size: 12px;
  color: var(--text-muted);
}

.chart-legend {
  display: flex;
  gap: 14px;
  font-size: 12px;
  color: var(--text-secondary);
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 6px;
}

.dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  display: inline-block;
}

.dot.income  { background-color: var(--accent-primary); }
.dot.expense { background-color: #cbd5e1; }

/* Gráfica de Barras CSS */
.bar-chart {
  height: 220px;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16px;
  padding-top: 24px;
  border-bottom: 1px solid var(--border-color);
}

.bar-group {
  flex: 1;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
}

.bars {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 6px;
}

.bar {
  width: 18px;
  border-radius: 6px 6px 0 0;
  transition: opacity 0.2s ease, transform 0.2s ease;
  position: relative;
  cursor: pointer;
}

.bar:hover {
  opacity: 0.85;
  transform: scaleY(1.03);
  transform-origin: bottom;
}

.bar.income  { background-color: var(--accent-primary); }
.bar.expense { background-color: #cbd5e1; }

.bar-label {
  font-size: 12px;
  color: var(--text-secondary);
  margin-top: 10px;
  margin-bottom: -26px;
}

.bar-group.active .bar-label {
  font-weight: 700;
  color: var(--accent-primary);
}

/* Compromisos y Barras de Progreso */
.obligation-block {
  margin-bottom: 16px;
}

.obligation-top {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8px;
  font-size: 14px;
}

.ob-title { font-weight: 500; }
.ob-amount { font-weight: 600; }

.progress-track {
  height: 8px;
  background-color: var(--bg-subtle);
  border-radius: 99px;
  overflow: hidden;
  margin-bottom: 6px;
}

.progress-fill {
  height: 100%;
  border-radius: 99px;
}

.progress-fill.income  { background-color: var(--color-positive); }
.progress-fill.warning { background-color: var(--color-warning); }

.obligation-meta {
  display: flex;
  justify-content: space-between;
  font-size: 11px;
  color: var(--text-muted);
}

.divider {
  height: 1px;
  background-color: var(--border-color);
  margin: 18px 0;
}

.flow-preview-box {
  background-color: var(--bg-subtle);
  border-radius: var(--radius-md);
  padding: 14px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  margin-top: 18px;
}

.flow-preview-info {
  display: flex;
  flex-direction: column;
  font-size: 12px;
}

.flow-preview-info span {
  color: var(--text-secondary);
  font-size: 11px;
}

/* =========================================
   7. TABLA DE TRANSACCIONES LIMPIA
   ========================================= */
.table-responsive {
  overflow-x: auto;
}

.fintech-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 13px;
}

.fintech-table th {
  text-align: left;
  font-size: 11px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--text-muted);
  padding: 12px 10px;
  border-bottom: 1px solid var(--border-color);
}

.fintech-table td {
  padding: 14px 10px;
  border-bottom: 1px solid var(--bg-subtle);
  vertical-align: middle;
}

.fintech-table tr:last-child td {
  border-bottom: none;
}

.fintech-table tr:hover td {
  background-color: #fafbfc;
}

.tx-entity {
  display: flex;
  align-items: center;
  gap: 12px;
}

.tx-icon {
  width: 32px;
  height: 32px;
  border-radius: 8px;
  display: grid;
  place-items: center;
  font-weight: 700;
  font-size: 14px;
}

.tx-icon.in  { background-color: var(--color-positive-bg); color: var(--color-positive); }
.tx-icon.out { background-color: var(--bg-subtle); color: var(--text-secondary); }

.tx-entity strong {
  display: block;
  font-size: 13px;
  color: var(--text-primary);
}

.tx-sub {
  font-size: 11px;
  color: var(--text-muted);
}

.badge {
  font-size: 11px;
  font-weight: 600;
  padding: 4px 10px;
  border-radius: 99px;
}

.badge-income  { background-color: var(--color-positive-bg); color: var(--color-positive); }
.badge-neutral { background-color: var(--bg-subtle); color: var(--text-secondary); }

/* =========================================
   8. RESPONSIVIDAD (TABLET Y MÓVIL)
   ========================================= */
@media (max-width: 1150px) {
  .kpi-grid {
    grid-template-columns: repeat(2, 1fr);
  }
  .dashboard-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 768px) {
  .sidebar {
    display: none; /* En móvil se convertirá en menú colapsable con JS */
  }
  .main-content {
    margin-left: 0;
    padding: 20px;
  }
  .kpi-grid {
    grid-template-columns: 1fr;
  }
}


